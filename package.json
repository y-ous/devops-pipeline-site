    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "html-validate": "^8.29.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
