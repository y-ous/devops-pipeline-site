{
  "name": "devops-pipeline-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Simpele takenlijst-website om een volledige CI/CD-pipeline mee te demonstreren.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
